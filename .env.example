# ==========================================
# CONFIGURACIÓN OPCIONAL - INSTAGRAM FEED (@urbegestion)
# ==========================================
# Si deseas conectar tu cuenta de Instagram directamente con la API de Meta:
# 1. Crea una app en Meta for Developers (Instagram Basic Display / Graph API)
# 2. Genera un User Token de larga duración y pégalo aquí:
VITE_INSTAGRAM_ACCESS_TOKEN=

# O si utilizas un servicio de feed JSON como Behold.so, Curator.io o Elfsight:
VITE_INSTAGRAM_FEED_URL=

# ==========================================
# VARIABLES PÚBLICAS (se incluyen en el bundle: NUNCA poner secretos aquí)
# ==========================================
# Habilita el panel admin en producción (demo). Sin backend no hay autenticación real.
VITE_ENABLE_ADMIN=false
# 'server' usa el LLM de /api/chat; vacío usa el motor local.
VITE_AI_PROVIDER=
VITE_CAL_COM_URL=

# ==========================================
# VARIABLES PRIVADAS DEL SERVIDOR (configurar en Vercel, no en el cliente)
# ==========================================
# Proveedor del LLM: openai | openrouter | deepseek
AI_PROVIDER=openai
AI_MODEL=
LLM_API_KEY=
# Webhook de GoHighLevel / Zapier / Make
GHL_WEBHOOK_URL=
