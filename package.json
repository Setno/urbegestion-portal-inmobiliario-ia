{
  "name": "urbegestion-real-estate-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@portal/consola --",
    "build": "npm run build --workspace=@portal/consola",
    "preview": "npm run preview --workspace=@portal/consola --",
    "dev:sitio": "npm run dev --workspace=@portal/sitio --",
    "build:sitio": "npm run build --workspace=@portal/sitio",
    "lint": "eslint . apps/consola/src apps/consola/api apps/consola/tests packages/plataforma/src packages/mercados/src packages/dinero/src packages/sitio-datos/src apps/sitio/src supabase/functions",
    "verificar:supabase": "node --env-file=.env.local scripts/verificar-supabase.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
