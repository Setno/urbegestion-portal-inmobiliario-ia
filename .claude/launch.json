{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "sitio",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:sitio"],
      "env": { "NODE_OPTIONS": "--use-system-ca" },
      "port": 3001
    },
    {
      "name": "sitio-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--workspace=@portal/sitio"],
      "env": { "NODE_OPTIONS": "--use-system-ca", "SITIO_DOMINIO_BASE": "localhost" },
      "port": 3001
    },
    {
      "name": "preview-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--port", "4173"],
      "port": 4173
    }
  ]
}
